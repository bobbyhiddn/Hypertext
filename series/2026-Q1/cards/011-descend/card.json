    "RARITY_TEXT": "UNCOMMON",
    "RARITY_ICON": "UNCOMMON",
    "ART_PROMPT": "A brilliant white dove gliding downward through a vertical shaft of golden light that pierces through dark, heavy storm clouds to touch a mountain peak.",
    "ABILITY_TEXT": "Look at the top 3 cards of the Tower. You may put any number of them on the bottom of the Tower.",
    "STAT_LORE": 4,
    "STAT_CONTEXT": 3,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Genesis 28:12",
    "OT_VERSE_SNIPPET": "And behold, the angels of God were ascending and descending on it.",
    "NT_VERSE_REF": "Matthew 3:16",
    "NT_VERSE_SNIPPET": "He saw the Spirit of God descending like a dove and coming to rest on him.",
    "OT_VERSE_LINE": "Genesis 28:12 — “And behold, the angels of God were ascending and descending on it.”",
    "NT_VERSE_LINE": "Matthew 3:16 — “He saw the Spirit of God descending like a dove and coming to rest on him.”",
    "GREEK": "καταβαίνω",
    "GREEK_TRANSLIT": "katabainō",
    "HEBREW": "יָרַד",
    "HEBREW_TRANSLIT": "yarad",
