    "SERIES": "2026-Q1 Babel",
    "WORD": "GOD",
    "GLOSS": "The supreme being, Creator, and ruler of the universe; the eternal and infinite Spirit.",
    "CARD_TYPE": "TITLE",
    "RARITY_TEXT": "GLORIOUS",
