    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Psalm 23:1",
    "OT_VERSE_SNIPPET": "The LORD is my shepherd; I shall not want.",
    "NT_VERSE_REF": "John 10:11",
    "NT_VERSE_SNIPPET": "I am the good shepherd. The good shepherd gives His life for the sheep.",
    "OT_VERSE_LINE": "Psalm 23:1 — “The LORD is my shepherd; I shall not want.”",
    "NT_VERSE_LINE": "John 10:11 — “I am the good shepherd. The good shepherd gives His life for the sheep.”",
    "GREEK": "ποιμήν",
    "GREEK_TRANSLIT": "poimēn",
    "HEBREW": "רֹעֶה",
