{
  "style_guide": {
    "game_name": "Hypertext: Towerfall",
    "card_type": "word_study_trading_card",
    "orientation": "vertical",
    "aspect_ratio": "2:3",
    "target_resolution": {
      "width": 1024,
      "height": 1536
    },
    "visual_style": [
      "premium trading card layout",
      "antique parchment background with subtle grain",
      "navy and gold collector frame",
      "high legibility, crisp print-like typography",
      "clean TCG UI language with a large art window"
    ],
    "palette": {
      "primary": "navy",
      "secondary": "gold",
      "background": "warm parchment",
      "ink": "near-black"
    },
    "typography": {
      "title": "classic serif display",
      "labels": "uppercase small caps",
      "body": "clean serif",
      "glyph_support": [
        "Greek renders correctly",
        "Hebrew renders correctly right-to-left"
      ]
    },
    "iconography": {
      "rarity_system": {
        "placement": "top_right_small",
        "render_rule": "Render the rarity text followed by a small diamond icon. Format: 'RARE ◆'. All rarities use diamond shape, only fill color varies. No brackets.",
        "icons": {
          "COMMON": {
            "shape": "diamond",
            "fill": "white",
            "outline": "navy"
          },
          "UNCOMMON": {
            "shape": "diamond",
            "fill": "green",
            "outline": "navy"
          },
          "RARE": {
            "shape": "diamond",
            "fill": "gold",
            "outline": "navy"
          },
          "GLORIOUS": {
            "shape": "diamond",
            "fill": "orange",
            "outline": "navy"
          }
        }
      },
      "cost_indicator": {
        "placement": "below_rarity",
        "render_rule": "For RARE and GLORIOUS cards only, display the activation cost below the rarity diamond using a plus symbol and card icons.",
        "costs": {
          "COMMON": null,
          "UNCOMMON": null,
          "RARE": {
            "display": "+🂠",
            "meaning": "discard 1 card to activate"
          },
          "GLORIOUS": {
            "display": "+🂠🂠",
            "meaning": "discard 2 cards to activate"
          }
        }
      },
      "stat_pips": {
        "shape": "circle",
        "max": 5,
        "filled_style": "solid navy fill with gold outline",
        "empty_style": "parchment fill with navy outline",
        "no_other_shapes": true
      }
    }
  },
  "layout": {
    "frame": {
      "rounded_corners": true,
      "navy_border": "thick",
      "gold_trim": "thin",
      "corner_filigree": "subtle"
    },
    "top_microtext": {
      "left": "",
      "right": ""
    },
    "header": {
      "collector_id_left": "#{NUMBER} {CARD_TYPE}",
      "rarity_icon_and_text_right": {
        "icon_key": "RARITY_ICON",
        "text_key": "RARITY_TEXT"
      },
      "type_badge_left": "{CARD_TYPE}",
      "title_center_key": "WORD",
      "subtitle_center_key": "GLOSS"
    },
    "footer": {
      "series_left_key": "SERIES"
    },
    "art_panel": {
      "height_fraction": 0.44,
      "frame_style": "gold inner frame, navy outline",
      "art_prompt_key": "ART_PROMPT",
      "rules": [
        "no text inside artwork",
        "single coherent scene",
        "no modern objects"
      ]
    },
    "stats_row": {
      "stats": [
        {
          "label": "LORE",
          "pips_key": "STAT_LORE"
        },
        {
          "label": "CONTEXT",
          "pips_key": "STAT_CONTEXT"
        },
        {
          "label": "COMPLEXITY",
          "pips_key": "STAT_COMPLEXITY"
        }
      ]
    },
    "panels": [
      {
        "label": "ABILITY",
        "content_key": "ABILITY_TEXT"
      },
      {
        "label": "OT VERSE",
        "content_key": "OT_VERSE_LINE"
      },
      {
        "label": "NT VERSE",
        "content_key": "NT_VERSE_LINE"
      },
      {
        "type": "split",
        "left_label": "HEB/ARAM",
        "left_primary_key": "HEBREW",
        "left_secondary_label": "TRANSLIT",
        "left_secondary_key": "HEBREW_TRANSLIT",
        "left_refs_label": "OT",
        "left_refs_key": "OT_REFS",
        "right_label": "GREEK",
        "right_primary_key": "GREEK",
        "right_secondary_label": "TRANSLIT",
        "right_secondary_key": "GREEK_TRANSLIT",
        "right_refs_label": "NT",
        "right_refs_key": "NT_REFS"
      },
      {
        "label": "TRIVIA",
        "bullets_key": "TRIVIA_BULLETS",
        "bullets_count": 4
      }
    ]
  },
  "content": {
    "NUMBER": "005",
    "SERIES": "2026-Q1 Babel",
    "WORD": "CONFUSE",
    "GLOSS": "To mix up, bewilder, or throw into disorder; to scramble understanding.",
    "CARD_TYPE": "VERB",
    "RARITY_TEXT": "RARE",
    "RARITY_ICON": "RARE",
    "ART_PROMPT": "A spiraling ancient stone tower dissolving into swirling, multicolored mists against a chaotic sky, abstract and disorienting.",
    "ABILITY_TEXT": "Target player shuffles their hand into the Tower, then draws that many cards.",
    "STAT_LORE": 2,
    "STAT_CONTEXT": 5,
    "STAT_COMPLEXITY": 3,
    "OT_VERSE_REF": "Genesis 11:7",
    "OT_VERSE_SNIPPET": "Come, let Us go down and there confuse their language, that they may not understand one another’s speech.",
    "NT_VERSE_REF": "1 Corinthians 14:33",
    "NT_VERSE_SNIPPET": "For God is not the author of confusion but of peace, as in all the churches of the saints.",
    "OT_VERSE_LINE": "Genesis 11:7 — “Come, let Us go down and there confuse their language, that they may not understand one another’s speech.”",
    "NT_VERSE_LINE": "1 Corinthians 14:33 — “For God is not the author of confusion but of peace, as in all the churches of the saints.”",
    "GREEK": "ἀκαταστασία",
    "GREEK_TRANSLIT": "akatastasia",
    "HEBREW": "בָּלַל",
    "HEBREW_TRANSLIT": "balal",
    "OT_REFS": "Gen 11:7 • Gen 11:9 • Deut 28:28 • Isa 19:14",
    "NT_REFS": "1 Cor 14:33 • Acts 19:32 • Jas 3:16 • Acts 2:6",
    "TRIVIA_BULLETS": [
      "The Hebrew word 'balal' (to confuse) sounds like the name 'Babel'.",
      "In the NT, 'akatastasia' refers to disorder in worship rather than language.",
