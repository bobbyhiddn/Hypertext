{
  "style_guide": {
    "game_name": "Hypertext: Towerfall",
    "card_type": "word_study_trading_card",
    "orientation": "vertical",
    "aspect_ratio": "2:3",
    "target_resolution": {
      "width": 1024,
      "height": 1536
    },
    "visual_style": [
      "premium trading card layout",
      "antique parchment background with subtle grain",
      "navy and gold collector frame",
      "high legibility, crisp print-like typography",
      "clean TCG UI language with a large art window"
    ],
    "palette": {
      "primary": "navy",
      "secondary": "gold",
      "background": "warm parchment",
      "ink": "near-black"
    },
    "typography": {
      "title": "classic serif display",
      "labels": "uppercase small caps",
      "body": "clean serif",
      "glyph_support": [
        "Greek renders correctly",
        "Hebrew renders correctly right-to-left"
      ]
    },
    "iconography": {
      "rarity_system": {
        "placement": "top_right_small",
        "render_rule": "Render the rarity text followed by a small diamond icon. Format: 'RARE ◆'. All rarities use diamond shape, only fill color varies. No brackets.",
        "icons": {
          "COMMON": {
            "shape": "diamond",
            "fill": "white",
            "outline": "navy"
          },
          "UNCOMMON": {
            "shape": "diamond",
            "fill": "green",
            "outline": "navy"
          },
          "RARE": {
            "shape": "diamond",
            "fill": "gold",
            "outline": "navy"
          },
          "GLORIOUS": {
            "shape": "diamond",
            "fill": "orange",
            "outline": "navy"
          }
        }
      },
      "cost_indicator": {
        "placement": "below_rarity",
        "render_rule": "For RARE and GLORIOUS cards only, display the activation cost below the rarity diamond using a plus symbol and card icons.",
        "costs": {
          "COMMON": null,
          "UNCOMMON": null,
          "RARE": {
            "display": "+🂠",
            "meaning": "discard 1 card to activate"
          },
          "GLORIOUS": {
            "display": "+🂠🂠",
            "meaning": "discard 2 cards to activate"
          }
        }
      },
      "stat_pips": {
        "shape": "circle",
        "max": 5,
        "filled_style": "solid navy fill with gold outline",
        "empty_style": "parchment fill with navy outline",
        "no_other_shapes": true
      }
    }
  },
  "layout": {
    "frame": {
      "rounded_corners": true,
      "navy_border": "thick",
      "gold_trim": "thin",
      "corner_filigree": "subtle"
    },
    "top_microtext": {
      "left": "",
      "right": ""
    },
    "header": {
      "collector_id_left": "#{NUMBER} {CARD_TYPE}",
      "rarity_icon_and_text_right": {
        "icon_key": "RARITY_ICON",
        "text_key": "RARITY_TEXT"
      },
      "type_badge_left": "{CARD_TYPE}",
      "title_center_key": "WORD",
      "subtitle_center_key": "GLOSS"
    },
    "footer": {
      "series_left_key": "SERIES"
    },
    "art_panel": {
      "height_fraction": 0.44,
      "frame_style": "gold inner frame, navy outline",
      "art_prompt_key": "ART_PROMPT",
      "rules": [
        "no text inside artwork",
        "single coherent scene",
        "no modern objects"
      ]
    },
    "stats_row": {
      "stats": [
        {
          "label": "LORE",
          "pips_key": "STAT_LORE"
        },
        {
          "label": "CONTEXT",
          "pips_key": "STAT_CONTEXT"
        },
        {
          "label": "COMPLEXITY",
          "pips_key": "STAT_COMPLEXITY"
        }
      ]
    },
    "panels": [
      {
        "label": "ABILITY",
        "content_key": "ABILITY_TEXT"
      },
      {
        "label": "OT VERSE",
        "content_key": "OT_VERSE_LINE"
      },
      {
        "label": "NT VERSE",
        "content_key": "NT_VERSE_LINE"
      },
      {
        "type": "split",
        "left_label": "HEB/ARAM",
        "left_primary_key": "HEBREW",
        "left_secondary_label": "TRANSLIT",
        "left_secondary_key": "HEBREW_TRANSLIT",
        "left_refs_label": "OT",
        "left_refs_key": "OT_REFS",
        "right_label": "GREEK",
        "right_primary_key": "GREEK",
        "right_secondary_label": "TRANSLIT",
        "right_secondary_key": "GREEK_TRANSLIT",
        "right_refs_label": "NT",
        "right_refs_key": "NT_REFS"
      },
      {
        "label": "TRIVIA",
        "bullets_key": "TRIVIA_BULLETS",
        "bullets_count": 4
      }
    ]
  },
  "content": {
    "NUMBER": "030",
    "SERIES": "2026-Q1 Babel",
    "WORD": "CREATOR",
    "GLOSS": "One who brings something into existence out of nothing; specifically, God as the originator of the universe.",
    "CARD_TYPE": "TITLE",
    "RARITY_TEXT": "GLORIOUS",
    "RARITY_ICON": "GLORIOUS",
    "ART_PROMPT": "A pair of translucent, glowing hands shaping a swirling galaxy from cosmic dust and starlight; vibrant nebulas condensing into solid spheres against a deep void; light piercing darkness.",
    "ABILITY_TEXT": "Shuffle your hand and Sheol into the Tower, then draw 7 cards.",
    "STAT_LORE": 5,
    "STAT_CONTEXT": 5,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Ecclesiastes 12:1",
    "OT_VERSE_SNIPPET": "Remember also your Creator in the days of your youth, before the evil days come.",
    "NT_VERSE_REF": "Romans 1:25",
    "NT_VERSE_SNIPPET": "They exchanged the truth of God for a lie and worshiped and served the creature rather than the Creator.",
    "OT_VERSE_LINE": "Ecclesiastes 12:1 — “Remember also your Creator in the days of your youth, before the evil days come.”",
    "NT_VERSE_LINE": "Romans 1:25 — “They exchanged the truth of God for a lie and worshiped and served the creature rather than the Creator.”",
    "GREEK": "Κτίστης",
    "GREEK_TRANSLIT": "Ktistēs",
    "HEBREW": "בּוֹרֵא",
    "HEBREW_TRANSLIT": "Bore",
    "OT_REFS": "Gen 1:1 • Isa 40:28 • Eccl 12:1 • Isa 43:15",
    "NT_REFS": "Rom 1:25 • 1 Pet 4:19 • Col 1:16 • Rev 4:11",
    "TRIVIA_BULLETS": [
      "The Hebrew verb 'bara' is used exclusively of God's creative activity, never of humans.",
      "Paul contrasts 'Ktistes' (Creator) with 'ktisis' (creation) to define the essence of idolatry.",
      "The plural noun 'Elohim' appears in Genesis 1:1, emphasizing the majesty and complexity of the Creator."
