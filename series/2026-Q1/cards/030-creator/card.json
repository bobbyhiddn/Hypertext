    "OT_VERSE_REF": "Isaiah 40:28",
    "OT_VERSE_SNIPPET": "The Lord is the everlasting God, the Creator of the ends of the earth.",
    "NT_VERSE_REF": "1 Peter 4:19",
    "NT_VERSE_SNIPPET": "Entrust their souls to a faithful Creator while doing good.",
    "OT_VERSE_LINE": "Isaiah 40:28 — “The Lord is the everlasting God, the Creator of the ends of the earth.”",
    "NT_VERSE_LINE": "1 Peter 4:19 — “Entrust their souls to a faithful Creator while doing good.”",
    "GREEK": "κτίστης",
    "GREEK_TRANSLIT": "ktistēs",
    "HEBREW": "בּוֹרֵא",
    "HEBREW_TRANSLIT": "bore",
    "OT_REFS": "Gen 1:1 • Eccl 12:1 • Isa 43:15 • Amos 4:13",
    "NT_REFS": "Rom 1:25 • Col 1:16 • Rev 4:11 • Eph 3:9",
    "TRIVIA_BULLETS": [
      "The Hebrew verb 'bara' is used in the Bible exclusively with God as the subject.",
