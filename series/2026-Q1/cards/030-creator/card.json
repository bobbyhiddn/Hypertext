    "SERIES": "2026-Q1 Babel",
    "WORD": "CREATOR",
    "GLOSS": "One who brings something into existence; specifically God as the originator of the universe.",
    "CARD_TYPE": "TITLE",
    "RARITY_TEXT": "GLORIOUS",
