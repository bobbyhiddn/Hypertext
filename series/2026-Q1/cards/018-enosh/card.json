    "NUMBER": "018",
    "SERIES": "2026-Q1 Babel",
    "WORD": "ENOSH",
    "GLOSS": "Mortal man; frailty",
    "CARD_TYPE": "NAME",
    "RARITY_TEXT": "COMMON",
    "RARITY_ICON": "COMMON",
    "ART_PROMPT": "A solitary, humble figure kneeling in a vast, arid landscape under a starry twilight sky, hands raised slightly in prayer; atmospheric, earthy tones, ancient near east setting.",
    "ABILITY_TEXT": "Look at the top 2 cards of the Tower. Put one into your hand and the other into Sheol.",
    "STAT_LORE": 3,
    "STAT_CONTEXT": 2,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Genesis 4:26",
    "OT_VERSE_SNIPPET": "At that time people began to call upon the name of the LORD.",
    "NT_VERSE_REF": "Luke 3:38",
    "NT_VERSE_SNIPPET": "...the son of Enosh, the son of Seth, the son of Adam, the son of God.",
    "OT_VERSE_LINE": "Genesis 4:26 — “At that time people began to call upon the name of the LORD.”",
    "NT_VERSE_LINE": "Luke 3:38 — “...the son of Enosh, the son of Seth, the son of Adam, the son of God.”",
    "GREEK": "Ἐνώς",
    "GREEK_TRANSLIT": "Enōs",
    "HEBREW": "אֱנוֹשׁ",
    "HEBREW_TRANSLIT": "Enosh",
    "OT_REFS": "Gen 4:26 • Gen 5:6 • 1Chr 1:1 • Ps 8:4",
    "NT_REFS": "Luke 3:38",
    "TRIVIA_BULLETS": [
      "Name means 'mortal' or 'frail,' emphasizing human weakness.",
      "Grandson of Adam; his generation began public worship.",
      "Lived 905 years, bridging the history between Adam and Noah."
    ]
  },
  "render_instructions": {
    "strict_no_duplicate_headings": true,
    "single_panel_labels_render_once": true,
    "no_extra_panels": true,
    "text_accuracy_priority": "very_high",
    "no_warped_or_garbled_text": true,
    "hebrew_right_to_left": true,
    "no_text_inside_art_panel": true,
    "prioritize_legibility": true,
    "rarity_icon_must_be_exact_shape": true,
    "rarity_text_must_match_exactly": true,
    "output_must_contain_only_the_card": true,
    "no_text_outside_card_border": true,
    "no_captions_or_watermarks_outside_card": true,
    "do_not_render_hidden_metadata": [
      "WILD_ID",
      "WILD_COUNTS_AS",
      "QUARTET_ID",
      "LETTER",
      "NOTES_INTERNAL"
    ]
  },
  "model_prompt": "Generate a premium vertical trading card. Output ONLY the card; no surrounding text or watermarks. NEVER use brackets [ ]. RARITY: Print rarity text then a diamond icon (e.g. 'RARE ◆'). Diamond color: white=COMMON, green=UNCOMMON, gold=RARE, orange=GLORIOUS. All use same diamond shape. COST INDICATOR: Below rarity for RARE show '+🂠' (plus and one card), for GLORIOUS show '+🂠🂠' (plus and two cards). No cost indicator for COMMON/UNCOMMON. STAT PIPS: Use navy circles only, not diamonds. Render: header, stats, ability, OT verse, NT verse, Greek/Heb strip, trivia. Greek/Hebrew must be legible (Hebrew right-to-left).",
