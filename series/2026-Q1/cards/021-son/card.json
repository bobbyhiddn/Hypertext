    "SERIES": "2026-Q1 Babel",
    "WORD": "SON",
    "GLOSS": "Male offspring; an heir who inherits nature, status, and property.",
    "CARD_TYPE": "TITLE",
    "RARITY_TEXT": "COMMON",
    "RARITY_ICON": "COMMON",
    "ART_PROMPT": "A small child's hand reaching up to grasp the finger of a larger, gentle hand against a warm, golden light; soft focus, emotive style.",
    "ABILITY_TEXT": "Look at the top 2 cards of the Tower. Add one to your hand and put the other on the bottom.",
    "STAT_LORE": 4,
    "STAT_CONTEXT": 5,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Psalm 2:7",
    "OT_VERSE_SNIPPET": "You are my Son; today I have begotten you.",
    "NT_VERSE_REF": "Matthew 3:17",
    "NT_VERSE_SNIPPET": "This is my beloved Son, with whom I am well pleased.",
    "OT_VERSE_LINE": "Psalm 2:7 — “You are my Son; today I have begotten you.”",
    "NT_VERSE_LINE": "Matthew 3:17 — “This is my beloved Son, with whom I am well pleased.”",
    "GREEK": "υἱός",
    "GREEK_TRANSLIT": "huios",
    "HEBREW": "בֵּן",
