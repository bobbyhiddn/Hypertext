    "SERIES": "2026-Q1 Babel",
    "WORD": "KEEPER",
    "GLOSS": "One who guards, watches over, maintains, or protects from harm.",
    "CARD_TYPE": "TITLE",
    "RARITY_TEXT": "UNCOMMON",
    "RARITY_ICON": "UNCOMMON",
    "ART_PROMPT": "A heavy iron key hanging from a rough cord, illuminated by a single candle in a dark stone alcove; deep shadows, warm light, texture of old stone.",
    "ABILITY_TEXT": "Return a NOUN or NAME from Sheol to your hand.",
    "STAT_LORE": 3,
    "STAT_CONTEXT": 4,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Genesis 4:9",
    "OT_VERSE_SNIPPET": "And the Lord said unto Cain, Where is Abel thy brother? And he said, I know not: Am I my brother's keeper?",
    "NT_VERSE_REF": "Acts 5:23",
    "NT_VERSE_SNIPPET": "The prison truly found we shut with all safety, and the keepers standing without before the doors.",
    "OT_VERSE_LINE": "Genesis 4:9 — “And the Lord said unto Cain, Where is Abel thy brother? And he said, I know not: Am I my brother's keeper?”",
    "NT_VERSE_LINE": "Acts 5:23 — “The prison truly found we shut with all safety, and the keepers standing without before the doors.”",
    "GREEK": "φύλαξ",
    "GREEK_TRANSLIT": "phylax",
    "HEBREW": "שֹׁמֵר",
    "HEBREW_TRANSLIT": "shomer",
    "OT_REFS": "Gen 4:9 • Ps 121:5 • Eccl 12:3 • S.Sol 1:6",
    "NT_REFS": "Acts 5:23 • Acts 16:27 • Matt 28:4 • Tit 2:5",
    "TRIVIA_BULLETS": [
      "The Hebrew 'shomer' literally means 'to hedge about,' implying protection with thorns.",
      "First used by Cain in a deflection of responsibility regarding his brother Abel.",
      "Psalm 121 portrays God as the ultimate Keeper who 'shall not slumber nor sleep.'"
    ]
  },
  "render_instructions": {
    "strict_no_duplicate_headings": true,
    "single_panel_labels_render_once": true,
    "no_extra_panels": true,
    "text_accuracy_priority": "very_high",
    "no_warped_or_garbled_text": true,
    "hebrew_right_to_left": true,
    "no_text_inside_art_panel": true,
    "prioritize_legibility": true,
    "rarity_icon_must_be_exact_shape": true,
    "rarity_text_must_match_exactly": true,
    "output_must_contain_only_the_card": true,
    "no_text_outside_card_border": true,
    "no_captions_or_watermarks_outside_card": true,
    "do_not_render_hidden_metadata": [
      "WILD_ID",
      "WILD_COUNTS_AS",
      "QUARTET_ID",
      "LETTER",
      "NOTES_INTERNAL"
    ]
  },
  "model_prompt": "Generate a premium vertical trading card. Output ONLY the card; no surrounding text or watermarks. NEVER use brackets [ ]. RARITY: Print rarity text then a diamond icon (e.g. 'RARE ◆'). Diamond color: white=COMMON, green=UNCOMMON, gold=RARE, orange=GLORIOUS. All use same diamond shape. COST INDICATOR: Below rarity for RARE show '+🂠' (plus and one card), for GLORIOUS show '+🂠🂠' (plus and two cards). No cost indicator for COMMON/UNCOMMON. STAT PIPS: Use navy circles only, not diamonds. Render: header, stats, ability, OT verse, NT verse, Greek/Heb strip, trivia. Greek/Hebrew must be legible (Hebrew right-to-left).",
