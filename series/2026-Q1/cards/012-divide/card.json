{
  "style_guide": {
    "game_name": "Hypertext: Towerfall",
    "card_type": "word_study_trading_card",
    "orientation": "vertical",
    "aspect_ratio": "2:3",
    "target_resolution": {
      "width": 1024,
      "height": 1536
    },
    "visual_style": [
      "premium trading card layout",
      "antique parchment background with subtle grain",
      "navy and gold collector frame",
      "high legibility, crisp print-like typography",
      "clean TCG UI language with a large art window"
    ],
    "palette": {
      "primary": "navy",
      "secondary": "gold",
      "background": "warm parchment",
      "ink": "near-black"
    },
    "typography": {
      "title": "classic serif display",
      "labels": "uppercase small caps",
      "body": "clean serif",
      "glyph_support": [
        "Greek renders correctly",
        "Hebrew renders correctly right-to-left"
      ]
    },
    "iconography": {
      "rarity_system": {
        "placement": "top_right_small",
        "render_rule": "Render the rarity text followed by a small diamond icon. Format: 'RARE ◆'. All rarities use diamond shape, only fill color varies. No brackets.",
        "icons": {
          "COMMON": {
            "shape": "diamond",
            "fill": "white",
            "outline": "navy"
          },
          "UNCOMMON": {
            "shape": "diamond",
            "fill": "green",
            "outline": "navy"
          },
          "RARE": {
            "shape": "diamond",
            "fill": "gold",
            "outline": "navy"
          },
          "GLORIOUS": {
            "shape": "diamond",
            "fill": "orange",
            "outline": "navy"
          }
        }
      },
      "cost_indicator": {
        "placement": "below_rarity",
        "render_rule": "For RARE and GLORIOUS cards only, display the activation cost below the rarity diamond using a plus symbol and card icons.",
        "costs": {
          "COMMON": null,
          "UNCOMMON": null,
          "RARE": {
            "display": "+🂠",
            "meaning": "discard 1 card to activate"
          },
          "GLORIOUS": {
            "display": "+🂠🂠",
            "meaning": "discard 2 cards to activate"
          }
        }
      },
      "stat_pips": {
        "shape": "circle",
        "max": 5,
        "filled_style": "solid navy fill with gold outline",
        "empty_style": "parchment fill with navy outline",
        "no_other_shapes": true
      }
    }
  },
  "layout": {
    "frame": {
      "rounded_corners": true,
      "navy_border": "thick",
      "gold_trim": "thin",
      "corner_filigree": "subtle"
    },
    "top_microtext": {
      "left": "",
      "right": ""
    },
    "header": {
      "collector_id_left": "#{NUMBER} {CARD_TYPE}",
      "rarity_icon_and_text_right": {
        "icon_key": "RARITY_ICON",
        "text_key": "RARITY_TEXT"
      },
      "type_badge_left": "{CARD_TYPE}",
      "title_center_key": "WORD",
      "subtitle_center_key": "GLOSS"
    },
    "footer": {
      "series_left_key": "SERIES"
    },
    "art_panel": {
      "height_fraction": 0.44,
      "frame_style": "gold inner frame, navy outline",
      "art_prompt_key": "ART_PROMPT",
      "rules": [
        "no text inside artwork",
        "single coherent scene",
        "no modern objects"
      ]
    },
    "stats_row": {
      "stats": [
        {
          "label": "LORE",
          "pips_key": "STAT_LORE"
        },
        {
          "label": "CONTEXT",
          "pips_key": "STAT_CONTEXT"
        },
        {
          "label": "COMPLEXITY",
          "pips_key": "STAT_COMPLEXITY"
        }
      ]
    },
    "panels": [
      {
        "label": "ABILITY",
        "content_key": "ABILITY_TEXT"
      },
      {
        "label": "OT VERSE",
        "content_key": "OT_VERSE_LINE"
      },
      {
        "label": "NT VERSE",
        "content_key": "NT_VERSE_LINE"
      },
      {
        "type": "split",
        "left_label": "HEB/ARAM",
        "left_primary_key": "HEBREW",
        "left_secondary_label": "TRANSLIT",
        "left_secondary_key": "HEBREW_TRANSLIT",
        "left_refs_label": "OT",
        "left_refs_key": "OT_REFS",
        "right_label": "GREEK",
        "right_primary_key": "GREEK",
        "right_secondary_label": "TRANSLIT",
        "right_secondary_key": "GREEK_TRANSLIT",
        "right_refs_label": "NT",
        "right_refs_key": "NT_REFS"
      },
      {
        "label": "TRIVIA",
        "bullets_key": "TRIVIA_BULLETS",
        "bullets_count": 4
      }
    ]
  },
  "content": {
    "NUMBER": "012",
    "SERIES": "2026-Q1 Babel",
    "WORD": "DIVIDE",
    "GLOSS": "To separate into parts; to distinguish, partition, or distribute shares.",
    "CARD_TYPE": "VERB",
    "RARITY_TEXT": "UNCOMMON",
    "RARITY_ICON": "UNCOMMON",
    "ART_PROMPT": "A stark, abstract composition showing a vertical rift of pure white light splitting a chaotic, dark, swirling mass into two distinct, ordered halves. High contrast, geometric style.",
    "ABILITY_TEXT": "Reveal the top 3 cards of the Tower. Put 1 into your hand, 1 into Sheol, and 1 on the bottom of the Tower.",
    "STAT_LORE": 4,
    "STAT_CONTEXT": 5,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Genesis 1:4",
    "OT_VERSE_SNIPPET": "And God saw the light, that it was good: and God divided the light from the darkness.",
    "NT_VERSE_REF": "Hebrews 4:12",
    "NT_VERSE_SNIPPET": "Piercing even to the dividing asunder of soul and spirit, and of the joints and marrow.",
    "OT_VERSE_LINE": "Genesis 1:4 — “And God saw the light, that it was good: and God divided the light from the darkness.”",
    "NT_VERSE_LINE": "Hebrews 4:12 — “Piercing even to the dividing asunder of soul and spirit, and of the joints and marrow.”",
    "GREEK": "μερισμός",
    "GREEK_TRANSLIT": "merismos",
    "HEBREW": "בָּדַל",
    "HEBREW_TRANSLIT": "badal",
    "OT_REFS": "Gen 1:7 • Ex 14:21 • Ps 78:13 • Dan 5:28",
    "NT_REFS": "Luke 12:13 • 1 Cor 1:13 • 2 Tim 2:15 • Matt 25:32",
    "TRIVIA_BULLETS": [
      "The Hebrew 'badal' appears five times in Genesis 1 to describe God separating distinct elements.",
      "Hebrews 4:12 claims the Word of God is sharp enough to divide the immaterial soul and spirit.",
      "In 2 Timothy 2:15, 'rightly dividing' translates 'orthotomeō', literally meaning 'to cut a straight path'."
    ]
  },
  "render_instructions": {
    "strict_no_duplicate_headings": true,
    "single_panel_labels_render_once": true,
    "no_extra_panels": true,
    "text_accuracy_priority": "very_high",
    "no_warped_or_garbled_text": true,
    "hebrew_right_to_left": true,
    "no_text_inside_art_panel": true,
    "prioritize_legibility": true,
    "rarity_icon_must_be_exact_shape": true,
    "rarity_text_must_match_exactly": true,
    "output_must_contain_only_the_card": true,
    "no_text_outside_card_border": true,
    "no_captions_or_watermarks_outside_card": true,
    "do_not_render_hidden_metadata": [
      "WILD_ID",
      "WILD_COUNTS_AS",
      "QUARTET_ID",
      "LETTER",
      "NOTES_INTERNAL"
    ]
  },
