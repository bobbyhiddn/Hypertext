{
  "style_guide": {
    "game_name": "Hypertext: Towerfall",
    "card_type": "word_study_trading_card",
    "orientation": "vertical",
    "aspect_ratio": "2:3",
    "target_resolution": {
      "width": 1024,
      "height": 1536
    },
    "visual_style": [
      "premium trading card layout",
      "antique parchment background with subtle grain",
      "navy and gold collector frame",
      "high legibility, crisp print-like typography",
      "clean TCG UI language with a large art window"
    ],
    "palette": {
      "primary": "navy",
      "secondary": "gold",
      "background": "warm parchment",
      "ink": "near-black"
    },
    "typography": {
      "title": "classic serif display",
      "labels": "uppercase small caps",
      "body": "clean serif",
      "glyph_support": [
        "Greek renders correctly",
        "Hebrew renders correctly right-to-left"
      ]
    },
    "iconography": {
      "rarity_system": {
        "placement": "top_right_small",
        "render_rule": "Render the rarity text followed by a small diamond icon. Format: 'RARE ◆'. All rarities use diamond shape, only fill color varies. No brackets.",
        "icons": {
          "COMMON": {
            "shape": "diamond",
            "fill": "white",
            "outline": "navy"
          },
          "UNCOMMON": {
            "shape": "diamond",
            "fill": "green",
            "outline": "navy"
          },
          "RARE": {
            "shape": "diamond",
            "fill": "gold",
            "outline": "navy"
          },
          "GLORIOUS": {
            "shape": "diamond",
            "fill": "orange",
            "outline": "navy"
          }
        }
      },
      "cost_indicator": {
        "placement": "below_rarity",
        "render_rule": "For RARE and GLORIOUS cards only, display the activation cost below the rarity diamond using a plus symbol and card icons.",
        "costs": {
          "COMMON": null,
          "UNCOMMON": null,
          "RARE": {
            "display": "+🂠",
            "meaning": "discard 1 card to activate"
          },
          "GLORIOUS": {
            "display": "+🂠🂠",
            "meaning": "discard 2 cards to activate"
          }
        }
      },
      "stat_pips": {
        "shape": "circle",
        "max": 5,
        "filled_style": "solid navy fill with gold outline",
        "empty_style": "parchment fill with navy outline",
        "no_other_shapes": true
      }
    }
  },
  "layout": {
    "frame": {
      "rounded_corners": true,
      "navy_border": "thick",
      "gold_trim": "thin",
      "corner_filigree": "subtle"
    },
    "top_microtext": {
      "left": "",
      "right": ""
    },
    "header": {
      "collector_id_left": "#{NUMBER} {CARD_TYPE}",
      "rarity_icon_and_text_right": {
        "icon_key": "RARITY_ICON",
        "text_key": "RARITY_TEXT"
      },
      "type_badge_left": "{CARD_TYPE}",
      "title_center_key": "WORD",
      "subtitle_center_key": "GLOSS"
    },
    "footer": {
      "series_left_key": "SERIES"
    },
    "art_panel": {
      "height_fraction": 0.44,
      "frame_style": "gold inner frame, navy outline",
      "art_prompt_key": "ART_PROMPT",
      "rules": [
        "no text inside artwork",
        "single coherent scene",
        "no modern objects"
      ]
    },
    "stats_row": {
      "stats": [
        {
          "label": "LORE",
          "pips_key": "STAT_LORE"
        },
        {
          "label": "CONTEXT",
          "pips_key": "STAT_CONTEXT"
        },
        {
          "label": "COMPLEXITY",
          "pips_key": "STAT_COMPLEXITY"
        }
      ]
    },
    "panels": [
      {
        "label": "ABILITY",
        "content_key": "ABILITY_TEXT"
      },
      {
        "label": "OT VERSE",
        "content_key": "OT_VERSE_LINE"
      },
      {
        "label": "NT VERSE",
        "content_key": "NT_VERSE_LINE"
      },
      {
        "type": "split",
        "left_label": "HEB/ARAM",
        "left_primary_key": "HEBREW",
        "left_secondary_label": "TRANSLIT",
        "left_secondary_key": "HEBREW_TRANSLIT",
        "left_refs_label": "OT",
        "left_refs_key": "OT_REFS",
        "right_label": "GREEK",
        "right_primary_key": "GREEK",
        "right_secondary_label": "TRANSLIT",
        "right_secondary_key": "GREEK_TRANSLIT",
        "right_refs_label": "NT",
        "right_refs_key": "NT_REFS"
      },
      {
        "label": "TRIVIA",
        "bullets_key": "TRIVIA_BULLETS",
        "bullets_count": 4
      }
    ]
  },
  "content": {
    "NUMBER": "011",
    "SERIES": "2026-Q1 Babel",
    "WORD": "SEED",
    "GLOSS": "The grain from which a plant grows; figuratively, offspring, descendants, or the Word of God.",
    "CARD_TYPE": "NOUN",
    "RARITY_TEXT": "COMMON",
    "RARITY_ICON": "COMMON",
    "ART_PROMPT": "A single golden grain of wheat resting in a furrow of dark, rich soil, with a faint golden light emanating from within the shell, cinematic lighting, macro photography style.",
    "ABILITY_TEXT": "Place a card from your hand on the bottom of the Tower to draw 2 cards.",
    "STAT_LORE": 4,
    "STAT_CONTEXT": 5,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Genesis 3:15",
    "OT_VERSE_SNIPPET": "I will put enmity between thee and the woman, and between thy seed and her seed; it shall bruise thy head.",
    "NT_VERSE_REF": "Luke 8:11",
    "NT_VERSE_SNIPPET": "Now the parable is this: The seed is the word of God.",
    "OT_VERSE_LINE": "Genesis 3:15 — “I will put enmity between thee and the woman, and between thy seed and her seed; it shall bruise thy head.”",
    "NT_VERSE_LINE": "Luke 8:11 — “Now the parable is this: The seed is the word of God.”",
    "GREEK": "σπέρμα",
    "GREEK_TRANSLIT": "Sperma",
    "HEBREW": "זֶרַע",
    "HEBREW_TRANSLIT": "Zera",
    "OT_REFS": "Gen 12:7 • Jer 31:27 • Ps 126:6 • Gen 8:22",
    "NT_REFS": "Gal 3:16 • 1 Pet 1:23 • Matt 13:31 • Mark 4:31",
    "TRIVIA_BULLETS": [
      "Genesis 3:15 is known as the Protoevangelium, the first promise of the Messiah as the 'Seed of the woman'.",
      "The Hebrew 'zera' and Greek 'sperma' are used interchangeably for agricultural grain and human descendants.",
      "In Galatians 3, Paul argues that the Abrahamic promise was made to one 'Seed' (singular), referring to Christ."
