    "NT_VERSE_REF": "Romans 12:21",
    "NT_VERSE_SNIPPET": "Do not be overcome by evil, but overcome evil with good.",
    "OT_VERSE_LINE": "Genesis 50:20 — “As for you, you meant evil against me, but God meant it for good...”",
    "NT_VERSE_LINE": "Romans 12:21 — “Do not be overcome by evil, but overcome evil with good.”",
    "GREEK": "κακός",
    "GREEK_TRANSLIT": "kakos",
    "HEBREW": "רַע",
    "HEBREW_TRANSLIT": "ra'",
    "OT_REFS": "Gen 6:5 • Gen 50:20 • Ps 23:4",
