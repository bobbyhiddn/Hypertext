    "SERIES": "2026-Q1 Babel",
    "WORD": "REST",
    "GLOSS": "To cease work or movement in order to relax, refresh, or recover strength.",
    "CARD_TYPE": "VERB",
    "RARITY_TEXT": "GLORIOUS",
    "RARITY_ICON": "GLORIOUS",
    "ART_PROMPT": "A weathered iron plow abandoned in a grassy field at twilight, golden hour lighting, peaceful and still, oil painting style, no text",
    "ABILITY_TEXT": "Target player skips their next turn.",
    "STAT_LORE": 5,
    "STAT_CONTEXT": 5,
    "STAT_COMPLEXITY": 2,
    "OT_VERSE_REF": "Genesis 2:2",
    "OT_VERSE_SNIPPET": "And on the seventh day God ended his work which he had made; and he rested.",
    "NT_VERSE_REF": "Matthew 11:28",
    "NT_VERSE_SNIPPET": "Come unto me, all ye that labour and are heavy laden, and I will give you rest.",
    "OT_VERSE_LINE": "Genesis 2:2 — “And on the seventh day God ended his work which he had made; and he rested.”",
    "NT_VERSE_LINE": "Matthew 11:28 — “Come unto me, all ye that labour and are heavy laden, and I will give you rest.”",
    "GREEK": "ἀναπαύω",
    "GREEK_TRANSLIT": "Anapauō",
    "HEBREW": "שָׁבַת",
    "HEBREW_TRANSLIT": "Shabat",
    "OT_REFS": "Gen 2:2 • Ex 20:8 • Lev 25:4 • Ps 23:2",
    "NT_REFS": "Matt 11:28 • Heb 4:9 • Rev 14:13 • Mark 2:27",
    "TRIVIA_BULLETS": [
      "The Hebrew *shabat* literally means 'to cease' or 'stop,' not just to relax.",
      "God's rest on the seventh day was not from exhaustion, but completion.",
      "Jesus offers 'rest for the soul,' fulfilling the Sabbath's ultimate promise."
    ]
  },
  "render_instructions": {
    "strict_no_duplicate_headings": true,
    "single_panel_labels_render_once": true,
    "no_extra_panels": true,
    "text_accuracy_priority": "very_high",
    "no_warped_or_garbled_text": true,
    "hebrew_right_to_left": true,
    "no_text_inside_art_panel": true,
    "prioritize_legibility": true,
    "rarity_icon_must_be_exact_shape": true,
    "rarity_text_must_match_exactly": true,
    "output_must_contain_only_the_card": true,
    "no_text_outside_card_border": true,
    "no_captions_or_watermarks_outside_card": true,
    "do_not_render_hidden_metadata": [
      "WILD_ID",
      "WILD_COUNTS_AS",
      "QUARTET_ID",
      "LETTER",
      "NOTES_INTERNAL"
    ]
  },
  "model_prompt": "Generate a premium vertical trading card. Output ONLY the card; no surrounding text or watermarks. NEVER use brackets [ ]. RARITY: Print rarity text then a diamond icon (e.g. 'RARE ◆'). Diamond color: white=COMMON, green=UNCOMMON, gold=RARE, orange=GLORIOUS. All use same diamond shape. COST INDICATOR: Below rarity for RARE show '+🂠' (plus and one card), for GLORIOUS show '+🂠🂠' (plus and two cards). No cost indicator for COMMON/UNCOMMON. STAT PIPS: Use navy circles only, not diamonds. Render: header, stats, ability, OT verse, NT verse, Greek/Heb strip, trivia. Greek/Hebrew must be legible (Hebrew right-to-left).",
