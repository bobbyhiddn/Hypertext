{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypertext.local/schema/visual-descriptor-v1.json",
  "title": "Hypertext visual descriptor grammar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "HYPERTEXT_GLOBAL", "structures", "types", "rarities", "sizes", "composition"],
  "properties": {
    "schema_version": {"const": 1},
    "HYPERTEXT_GLOBAL": {"$ref": "#/$defs/global"},
    "structures": {
      "type": "object", "additionalProperties": false,
      "required": ["WORD_CARD", "LOT"],
      "properties": {"WORD_CARD": {"$ref": "#/$defs/wordCard"}, "LOT": {"$ref": "#/$defs/lot"}}
    },
    "types": {
      "type": "object", "additionalProperties": false,
      "required": ["NOUN", "VERB", "ADJECTIVE", "NAME", "TITLE"],
      "properties": {
        "NOUN": {"$ref": "#/$defs/typeTreatment"}, "VERB": {"$ref": "#/$defs/typeTreatment"},
        "ADJECTIVE": {"$ref": "#/$defs/typeTreatment"}, "NAME": {"$ref": "#/$defs/typeTreatment"},
        "TITLE": {"$ref": "#/$defs/typeTreatment"}
      }
    },
    "rarities": {
      "type": "object", "additionalProperties": false,
      "required": ["COMMON", "UNCOMMON", "RARE", "GLORIOUS"],
      "properties": {
        "COMMON": {"$ref": "#/$defs/rarityTreatment"}, "UNCOMMON": {"$ref": "#/$defs/rarityTreatment"},
        "RARE": {"$ref": "#/$defs/rarityTreatment"}, "GLORIOUS": {"$ref": "#/$defs/rarityTreatment"}
      }
    },
    "sizes": {
      "type": "object", "additionalProperties": false,
      "required": ["LOT_5", "LOT_6", "LOT_7"],
      "properties": {
        "LOT_5": {"$ref": "#/$defs/lot5"},
        "LOT_6": {"$ref": "#/$defs/lot6"}, "LOT_7": {"$ref": "#/$defs/lot7"}
      }
    },
    "composition": {
      "type": "object", "additionalProperties": false, "required": ["modes", "default"],
      "properties": {"modes": {"const": ["EXPLICIT", "PATTERN"]}, "default": {"enum": ["EXPLICIT", "PATTERN"]}}
    }
  },
  "$defs": {
    "canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height", "aspect_ratio"], "properties": {"width": {"const": 1024}, "height": {"const": 1536}, "aspect_ratio": {"const": "2:3"}}},
    "global": {"type": "object", "additionalProperties": false, "required": ["canvas", "aesthetic", "negative"], "properties": {"canvas": {"$ref": "#/$defs/canvas"}, "aesthetic": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "negative": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "split": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"const": "OLD_TESTAMENT_HEBREW_ARAMAIC"}, "right": {"const": "NEW_TESTAMENT_GREEK"}}},
    "wordCard": {"type": "object", "additionalProperties": false, "required": ["kind", "geometry", "content_order"], "properties": {"kind": {"const": "WORD_CARD"}, "geometry": {"type": "object", "additionalProperties": false, "required": ["orientation", "frame", "art_panel_height_fraction", "original_language_split"], "properties": {"orientation": {"const": "vertical"}, "frame": {"type": "string"}, "art_panel_height_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "original_language_split": {"$ref": "#/$defs/split"}}}, "content_order": {"type": "array", "const": ["HEADER", "ART", "STATS", "ABILITY", "OT_VERSE", "NT_VERSE", "ORIGINAL_LANGUAGES", "TRIVIA", "FOOTER"]}}},
    "lot": {"type": "object", "additionalProperties": false, "required": ["kind", "geometry", "content_order", "spec_boundary"], "properties": {"kind": {"const": "LOT"}, "geometry": {"type": "object", "additionalProperties": false, "required": ["orientation", "frame"], "properties": {"orientation": {"const": "vertical"}, "frame": {"type": "object", "additionalProperties": false, "required": ["navy_border", "gold_trim"], "properties": {"navy_border": {"type": "string"}, "gold_trim": {"type": "string"}}}}}, "content_order": {"const": ["TITLE", "ART", "REWARD"]}, "spec_boundary": {"type": "string", "minLength": 1}}},
    "typeTreatment": {"type": "object", "additionalProperties": false, "required": ["scope", "icon", "prompt"], "properties": {"scope": {"const": "type_only"}, "icon": {"type": "string", "minLength": 1}, "prompt": {"type": "string", "minLength": 1}}},
    "rarityTreatment": {"type": "object", "additionalProperties": false, "required": ["scope", "prompt"], "properties": {"scope": {"const": "rarity_only"}, "prompt": {"type": "string", "minLength": 1}}},
    "lotSize": {"type": "object", "additionalProperties": false, "required": ["width", "height", "aspect_ratio", "card_count", "chapter_points", "page_letters", "composition"], "properties": {"width": {"const": 1024}, "height": {"const": 1536}, "aspect_ratio": {"const": "2:3"}, "card_count": {"type": "integer"}, "chapter_points": {"type": "integer"}, "page_letters": {"type": "integer"}, "composition": {"type": "array", "items": {"enum": ["NOUN", "VERB", "ADJECTIVE", "NAME", "TITLE"]}}}},
    "lot5": {"allOf": [{"$ref": "#/$defs/lotSize"}, {"properties": {"card_count": {"const": 5}, "chapter_points": {"const": 8}, "page_letters": {"const": 2}, "composition": {"const": ["NOUN", "NOUN", "VERB", "VERB", "ADJECTIVE"]}}}]},
    "lot6": {"allOf": [{"$ref": "#/$defs/lotSize"}, {"properties": {"card_count": {"const": 6}, "chapter_points": {"const": 10}, "page_letters": {"const": 2}, "composition": {"const": ["NOUN", "NOUN", "NOUN", "VERB", "VERB", "VERB"]}}}]},
    "lot7": {"allOf": [{"$ref": "#/$defs/lotSize"}, {"properties": {"card_count": {"const": 7}, "chapter_points": {"const": 14}, "page_letters": {"const": 3}, "composition": {"const": ["NOUN", "NOUN", "NOUN", "VERB", "VERB", "ADJECTIVE", "TITLE"]}}}]}
  }
}
