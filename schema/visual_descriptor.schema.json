{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypertext.local/schema/visual-descriptor-v1.json",
  "title": "Hypertext visual descriptor grammar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "HYPERTEXT_GLOBAL", "structures", "types", "rarities", "sizes", "composition"],
  "properties": {
    "schema_version": {"const": 1},
    "HYPERTEXT_GLOBAL": {"$ref": "#/$defs/global"},
    "structures": {
      "type": "object", "additionalProperties": false,
      "required": ["WORD_CARD", "LOT"],
      "properties": {"WORD_CARD": {"$ref": "#/$defs/structure"}, "LOT": {"$ref": "#/$defs/structure"}}
    },
    "types": {
      "type": "object", "additionalProperties": false,
      "required": ["NOUN", "VERB", "ADJECTIVE", "NAME", "TITLE"],
      "properties": {
        "NOUN": {"$ref": "#/$defs/treatment"}, "VERB": {"$ref": "#/$defs/treatment"},
        "ADJECTIVE": {"$ref": "#/$defs/treatment"}, "NAME": {"$ref": "#/$defs/treatment"},
        "TITLE": {"$ref": "#/$defs/treatment"}
      }
    },
    "rarities": {
      "type": "object", "additionalProperties": false,
      "required": ["COMMON", "UNCOMMON", "RARE", "GLORIOUS"],
      "properties": {
        "COMMON": {"$ref": "#/$defs/treatment"}, "UNCOMMON": {"$ref": "#/$defs/treatment"},
        "RARE": {"$ref": "#/$defs/treatment"}, "GLORIOUS": {"$ref": "#/$defs/treatment"}
      }
    },
    "sizes": {
      "type": "object", "additionalProperties": false,
      "required": ["LOT_5", "LOT_6", "LOT_7"],
      "properties": {
        "LOT_5": {"$ref": "#/$defs/canvas"},
        "LOT_6": {"$ref": "#/$defs/canvas"}, "LOT_7": {"$ref": "#/$defs/canvas"}
      }
    },
    "composition": {
      "type": "object", "additionalProperties": false, "required": ["modes", "default"],
      "properties": {"modes": {"const": ["EXPLICIT", "PATTERN"]}, "default": {"enum": ["EXPLICIT", "PATTERN"]}}
    }
  },
  "$defs": {
    "canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height", "aspect_ratio"], "properties": {"width": {"const": 1024}, "height": {"const": 1536}, "aspect_ratio": {"const": "2:3"}}},
    "global": {"type": "object", "required": ["canvas", "aesthetic", "negative"], "properties": {"canvas": {"$ref": "#/$defs/canvas"}, "aesthetic": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "negative": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "structure": {"type": "object", "required": ["kind", "geometry", "content_order"], "properties": {"kind": {"enum": ["WORD_CARD", "LOT"]}, "geometry": {"type": "object"}, "content_order": {"type": "array", "items": {"type": "string"}}, "spec_boundary": {"type": "string"}}},
    "treatment": {"type": "object", "additionalProperties": false, "required": ["scope", "prompt"], "properties": {"scope": {"enum": ["type_only", "rarity_only"]}, "prompt": {"type": "string", "minLength": 1}}}
  }
}
